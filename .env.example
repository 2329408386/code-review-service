# 复制为 .env 后填写。只有下面这些需要配置；其余参数均为内置默认值，
# 模型路由与检视范围在 Web 控制台中维护。

# ============ 必填：大模型网关（OpenAI 兼容） ============
# API Key 属于密钥，只写在 .env 中，不要提交到仓库。
OPENAI_API_BASE_URL=http://43.160.240.252:10015/v1
OPENAI_API_KEY=
OPENAI_MODEL=codex-auto-review

# ============ 必填：CodeHub（检视 CodeHub MR 并回写评论时需要） ============
CODEHUB_PRIVATE_TOKEN=
CODEHUB_APP_CODE=
# 建议配置：Webhook 请求头 X-CodeHub-Token 的共享密钥
CODEHUB_WEBHOOK_SECRET=

# ============ 建议：管理员账号（不配置时控制台只读） ============
ADMIN_USERNAME=
ADMIN_PASSWORD=

# ============ 可选（以下为默认值） ============
# CODEHUB_API_BASE_URL=https://repo-api-codeartsx-cn-southwest-2.sicarrier.com/api/v4
# ALLOWED_REPOSITORY_HOSTS=repo-git-codeartsx-cn-southwest-2.sicarrier.com
# SKIP_SOURCE_BRANCHES=develop
# CODEGRAPH_ENABLED=false
