# ============ 基础 ============
APP_ENV=development
DATA_DIR=./data
LOG_DIR=./log
PORT=8083

# ============ 管理员（控制台修改配置 / 重新检视 / 删除记录） ============
# 两项需同时配置；都留空则关闭管理员登录。未设置时使用代码中的默认账号。
ADMIN_USERNAME=
ADMIN_PASSWORD=

# ============ CodeHub ============
# 本地开发可留空：评论回写会记录为失败，而不会误调真实接口。
CODEHUB_API_BASE_URL=
CODEHUB_PRIVATE_TOKEN=
CODEHUB_APP_CODE=
# 可选：Webhook 请求头 X-CodeHub-Token 的共享密钥
CODEHUB_WEBHOOK_SECRET=
# 允许 clone 的仓库主机（逗号分隔）
ALLOWED_REPOSITORY_HOSTS=
# 仅本地测试时开启：允许 /path/to/repo 这类本地仓库路径
ALLOW_LOCAL_REPOSITORY_PATHS=false
COMMENT_HTTP_TIMEOUT_SECONDS=20
COMMENT_RATE_INTERVAL_SECONDS=5.1
COMMENT_MAX_ATTEMPTS=3

# ============ 检视范围 ============
# 全局跳过的源分支（精确匹配，逗号分隔；留空不跳过）
SKIP_SOURCE_BRANCHES=develop

# ============ 大模型默认网关（OpenAI 兼容） ============
# 模型路由未单独配置 Base URL / API Key 时使用这里的网关；Codex CLI 与 MR 评价摘要共用。
# OPENAI_MODEL 用于首次启动时生成“兜底”模型路由，之后以控制台“模型路由”配置为准。
# API Key 属于密钥，不要提交到仓库：写在 .env 或 .env.local 中。
OPENAI_API_BASE_URL=http://43.160.240.252:10015/v1
OPENAI_API_KEY=
OPENAI_MODEL=gemini-2.5-flash-lite
OPENAI_TIMEOUT_SECONDS=120
OPENAI_MAX_ATTEMPTS=2

# ============ Codex CLI ============
CODEX_COMMAND=codex
CODEX_TIMEOUT_SECONDS=3600
CODEX_MAX_ATTEMPTS=2
# 是否在发现轮之后增加一轮证据复核（更准、更慢、更费 Token）
CODEX_VERIFICATION_ENABLED=false

# ============ 并发与分片 ============
MAX_REVIEW_CONCURRENCY=5
MAX_CODEX_CONCURRENCY=5
MAX_CHUNK_REVIEW_CONCURRENCY=5
GIT_COMMAND_TIMEOUT_SECONDS=120
REVIEW_DIFF_CONTEXT_LINES=12
MAX_PROMPT_DIFF_BYTES=200000
MAX_REVIEW_CHUNKS=100
LARGE_NEW_FILE_LINE_THRESHOLD=2000
# 分片数超过该值的大任务白天提交时延后到 LARGE_REVIEW_START_HOUR 点执行
LARGE_REVIEW_CHUNK_THRESHOLD=3
LARGE_REVIEW_START_HOUR=20
REVIEW_EVENT_DETAIL_MAX_CHARS=4000

# ============ CodeGraph（可选） ============
# 在每个任务的隔离 clone 中建一次符号 / 调用链索引；命令缺失、超时或失败时自动降级。
CODEGRAPH_ENABLED=false
CODEGRAPH_COMMAND=codegraph
CODEGRAPH_INDEX_TIMEOUT_SECONDS=1800
